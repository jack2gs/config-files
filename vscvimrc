""" ======================
"""      Core Settings
""" ======================

""" General Navigation
map ga :vsc workbench.action.showCommands<CR>


""" File/Buffer Navigation
noremap <leader>ff :vsc workbench.action.quickOpen<CR>
noremap <leader>fr :vsc workbench.action.openRecent<CR>
noremap <leader>fn :vsc welcome.showNewFileEntries<CR>
nmap <S-F2> :vsc explorer.newFile<CR>
nmap <A-F2> :vsc workbench.action.files.saveFiles<CR>


""" Code Navigation
noremap gc :vsc references-view.findImplementations<CR>
noremap gd :vsc editor.action.revealDefinition<CR>
noremap gD :vsc editor.action.goToTypeDefinition<CR>
noremap gf :vsc workbench.action.quickOpen<CR>
noremap gr :vsc references-view.findReferences<CR>
noremap gt :vsc workbench.action.quickTextSearch<CR>
noremap gs :vsc workbench.action.showAllSymbols<CR>

""" ======================
"""   Window Management
""" ======================

""" Pane Navigation
noremap <C-h> <C-w>h
noremap <C-l> <C-w>l
noremap <C-k> <C-w>k
moremap <C-j> <C-w>j

""" Window Operations
noremap <leader>wv <C-w>v
noremap <leader>ws <C-w>s
noremap <leader>wm :vsc workbench.action.moveEditorToNextGroup<CR>
noremap <leader>wM :vsc workbench.action.moveEditorToPreviousGroup<CR>

""" Display Modes
noremap <leader>wz :vsc workbench.action.toggleZenMode<CR>
noremap <leader>wf :vsc workbench.action.toggleFullScreen<CR>

""" Tool Windows
noremap <leader>vd :vsc workbench.view.debug<CR>
noremap <leader>vp :vsc workbench.actions.view.problems<CR>
noremap <leader>vs :vsc outline.focus<CR>

""" ======================
"""      Editing
""" ======================

""" Line Manipulation
noremap <C-S-Up> :m -2<CR>
noremap <C-S-Down> :m +1<CR>
noremap <leader>sl :sort<CR>

""" Black Hole Register
noremap <leader>d "_d
noremap <leader>c "_c
noremap <leader>x "_x

""" ======================
"""   Search & Replace
""" ======================

map <leader>sf :vsc actions.find<CR>
map <leader>sr :vsc editor.action.startFindReplaceAction<CR>
map <leader>sF :vsc workbench.action.findInFiles<CR>
map <leader>sR :vsc workbench.action.replaceInFiles<CR>
noremap <F8> :vsc editor.action.marker.nextInFiles<CR>
noremap <S-F8> :vsc editor.action.marker.prevInFiles<CR>

""" ======================
"""   Code Refactoring
""" ======================

noremap <leader>rn :vsc editor.action.rename<CR>
noremap <F2> :vsc editor.action.rename<CR>
noremap <leader>rr :vsc editor.action.refactor<CR>

""" Comments
noremap <leader>cb :vsc editor.action.blockComment<CR>
noremap <leader>cl :vsc editor.action.commentLine<CR>

""" Folding
"""map zc :vsc editor.fold<CR>
"""map zo :vsc editor.unfold<CR>
"""map zC :vsc editor.foldRecursively<CR>
"""map zO :vsc editor.unfoldRecursively<CR>
"""map zm :vsc editor.foldAllMarkerRegions<CR>
"""map zr :vsc editor.unfoldAllMarkerRegions<CR>
"""map zM :vsc editor.foldAll<CR>
"""map zR :vsc editor.unfoldAll<CR>
"""map za :vsc editor.toggleFold<CR>
"""map zA :vsc editor.toggleFoldRecursively<CR>

""" Help Doc
map K :vsc editor.action.showHover<CR>
map gK :vsc editor.action.triggerParameterHints<CR>
imap <A-k> :vsc editor.action.triggerParameterHints<CR>

""" ======================
"""   Miscellaneous
""" ======================

""" Tab Navigation
noremap <C-n> :tabnext<CR>
noremap <C-p> :tabprev<CR>
noremap <C-F4> :close<CR>
noremap <leader>tco :tabonly<CR>
noremap <leader>tcg :vsc workbench.action.closeEditorsInGroup<CR>
noremap <leader>tC :vsc workbench.action.closeAllEditors<CR>
""" Editor Actions 
noremap <C-S-T> :vsc workbench.action.reopenClosedEditor<CR>

""" Config Reload
noremap <leader>sc :source ~/.vscvimrc<CR>